# Awakened — environment variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file with real secrets.

# Public URL of the awakened-admin backend (no trailing slash)
VITE_ADMIN_API_URL=https://awakened-admin.vercel.app

# ── SkipCash (Task 3 — not yet integrated) ──────────────────────────────────
# Get these from the SkipCash Merchant Portal → Developer Settings
SKIPCASH_ENV=sandbox                   # "sandbox" or "production"
SKIPCASH_MERCHANT_ID=                  # Your merchant ID from the portal
SKIPCASH_KEY_ID=                       # Your API key ID
SKIPCASH_KEY_SECRET=                   # SECRET — never expose to the browser
SKIPCASH_WEBHOOK_SECRET=               # Webhook signing secret

# ── Vercel KV (for order storage — Task 3) ──────────────────────────────────
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── Email confirmation (Task 3) ──────────────────────────────────────────────
# Same Resend key used by awakened-admin; or a separate one
RESEND_API_KEY=
