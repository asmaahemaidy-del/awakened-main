{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/reserve", "destination": "/events", "permanent": true },
    {
      "source": "/whatsapp",
      "destination": "https://wa.me/97477106177?text=Hello%20Awakened%2C%20I%20would%20like%20to%20know%20more",
      "permanent": false
    },
    {
      "source": "/whatsapp-ar",
      "destination": "https://wa.me/97477106177?text=%D9%85%D8%B1%D8%AD%D8%A8%D8%A7%D9%8B%20%D8%A3%D9%88%D8%A7%D9%8A%D9%83%D9%86%D8%AF%D8%8C%20%D8%A3%D8%B1%D8%BA%D8%A8%20%D8%A8%D8%A7%D9%84%D8%A7%D8%B3%D8%AA%D9%81%D8%B3%D8%A7%D8%B1%20%D8%B9%D9%86%20%D8%AE%D8%AF%D9%85%D8%A7%D8%AA%D9%83%D9%85",
      "permanent": false
    },
    {
      "source": "/whatsapp-book",
      "destination": "https://wa.me/97477106177?text=Hello%20Awakened%2C%20I%20would%20like%20to%20book%20a%20session",
      "permanent": false
    },
    {
      "source": "/whatsapp-book-ar",
      "destination": "https://wa.me/97477106177?text=%D9%85%D8%B1%D8%AD%D8%A8%D8%A7%D9%8B%20%D8%A3%D9%88%D8%A7%D9%8A%D9%83%D9%86%D8%AF%D8%8C%20%D8%A3%D8%B1%D8%BA%D8%A8%20%D8%A8%D8%AD%D8%AC%D8%B2%20%D8%AC%D9%84%D8%B3%D8%A9",
      "permanent": false
    },
    {
      "source": "/whatsapp-retreats",
      "destination": "https://wa.me/97477106177?text=Hello%20Awakened%2C%20I%20am%20interested%20in%20your%20retreats",
      "permanent": false
    },
    {
      "source": "/whatsapp-retreats-ar",
      "destination": "https://wa.me/97477106177?text=%D9%85%D8%B1%D8%AD%D8%A8%D8%A7%D9%8B%20%D8%A3%D9%88%D8%A7%D9%8A%D9%83%D9%86%D8%AF%D8%8C%20%D8%A3%D9%86%D8%A7%20%D9%85%D9%87%D8%AA%D9%85%20%D8%A8%D8%A7%D9%84%D8%AE%D9%84%D9%88%D8%A7%D8%AA",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/checkout", "destination": "/_app" },
    { "source": "/checkout/:path*", "destination": "/_app" },
    { "source": "/payment/:path*", "destination": "/_app" },
    { "source": "/invoice", "destination": "/_app" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/images/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Permitted-Cross-Domain-Policies", "value": "none" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https: blob:; connect-src 'self' https://awakened-admin.vercel.app https://cloudflareinsights.com https://skipcash.app https://api.skipcash.app https://sandbox.skipcash.app https://skipcashtest.azurewebsites.net; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://awakened-admin.vercel.app https://skipcash.app https://sandbox.skipcash.app https://skipcashtest.azurewebsites.net;" }
      ]
    }
  ]
}
